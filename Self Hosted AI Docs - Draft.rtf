## 12\'a0`scripts/backup.sh`\
```bash\
#!/usr/bin/env bash\
set -euo pipefail\
TS=$(date +"%Y-%m-%d_%H-%M-%S")\
BACKUP_DIR=/backups/$TS\
mkdir -p "$BACKUP_DIR"\
\
echo "
\f5 \uc0\u8594 
\f4  Dumping Postgres\'85"\
docker compose exec -T postgres pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB" > "$BACKUP_DIR/db.sql"\
\
echo "
\f5 \uc0\u8594 
\f4  Copying n8n data\'85"\
docker compose cp n8n:/home/node/.n8n "$BACKUP_DIR/n8n_data"\
\
echo "
\f5 \uc0\u10003 
\f4  Backup complete: $BACKUP_DIR"\
